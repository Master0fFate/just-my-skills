{
  "version": "6.1.0",
  "profile": "reference-monochrome",
  "colors": {
    "bg": "#050505",
    "surface": "#0e0e0e",
    "selected": "#171717",
    "rule": "#292929",
    "control": "#737373",
    "muted": "#909090",
    "text": "#b8b8b8",
    "strong": "#eeeeee",
    "white": "#ffffff",
    "art-ink": "#222222"
  },
  "tints": {
    "cold": {
      "bg": "#04070b",
      "surface": "#0c1014",
      "selected": "#151a1f",
      "rule": "#262c32",
      "muted": "#8c949c",
      "text": "#b4bcc4",
      "strong": "#e6edf3",
      "white": "#f2f7fb",
      "art-ink": "#1f252b",
      "image_black": "#04070b",
      "image_white": "#dfe9f1"
    }
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "geometry": {
    "corner_radius_px": 0,
    "separator_px": 1,
    "focus_px": 2,
    "min_target_px": 24,
    "coarse_target_px": 44
  },
  "type_px": {
    "interface": 13,
    "metadata": 12,
    "interface_title": [
      16,
      20
    ],
    "reading": 16,
    "website_title": [
      24,
      40
    ],
    "display_serif": [
      28,
      52
    ],
    "voice_serif": 13,
    "micro": 11
  },
  "tracking_em": {
    "display": 0.32,
    "display_lower": 0.42,
    "voice": 0.22,
    "micro": 0.3,
    "body": 0
  },
  "rows_px": {
    "compact": [
      28,
      32
    ]
  },
  "mono_stack": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
  "serif_stack": "\"Cormorant Garamond\", \"EB Garamond\", Garamond, \"Hoefler Text\", \"Times New Roman\", serif",
  "contrast_checks": {
    "text_tokens": [
      "muted",
      "text",
      "strong"
    ],
    "surfaces": [
      "bg",
      "surface",
      "selected"
    ],
    "text_min": 4.5,
    "boundary_token": "control",
    "boundary_min": 3
  },
  "image": {
    "dither": {
      "matrix": 4,
      "gamma": 1.4,
      "black": 8,
      "white": 232,
      "pixel_cell_css": 2,
      "ambient_ink_token": "art-ink"
    },
    "whitewash": {
      "black": 28,
      "white": 110,
      "gamma": 1.0,
      "halo": 0.7,
      "halo_radius": 36,
      "fade": "radial",
      "grain": 0.07,
      "scratches": 10,
      "dither": "band",
      "matrix": 8,
      "ambient_peak": 0.3,
      "signature": {
        "void_share_min": 0.4,
        "white_share": [
          0.03,
          0.12
        ],
        "mid_share_max": 0.2,
        "relic_share_max": 0.05
      },
      "key_strength": 0.6
    },
    "default_role": "none"
  },
  "ornament": {
    "max_per_view": 5,
    "min_cropped_by_edge": 1,
    "stroke_px": 1,
    "never_over": [
      "controls",
      "interface text",
      "focus outline"
    ]
  },
  "notes": [
    "New design defaults, not extracted CSS.",
    "The rule and art-ink tokens are not for useful text.",
    "control is for small marks only. Never use it as a resting 4-sided field or button border.",
    "white is the single clipped white: display titles, sparkles, the hero light. Interface text uses strong.",
    "Cold tint values live outside colors because they are not neutral; the audit checks them only inside tint rules.",
    "Exact two-value pixel validation applies to strict binary image assets, not to a browser screenshot."
  ],
  "relics": {
    "crimson": "#c8102e",
    "venom": "#39d98a",
    "gold": "#c9a24a",
    "max_per_view": 1,
    "max_share": 0.05,
    "allowed_on": [
      "art",
      "one ornament"
    ]
  }
}
